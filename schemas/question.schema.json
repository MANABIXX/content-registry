{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MANABIXX Question",
  "type": "object",
  "required": [
    "id",
    "prompt",
    "options",
    "correct",
    "explanation"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string"
    },
    "topic": {
      "type": "string"
    },
    "level": {
      "type": "string"
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "correct": {
      "type": "integer",
      "minimum": 0
    },
    "explanation": {
      "type": "string"
    },
    "takeaway": {
      "type": "string"
    },
    "sourceNote": {
      "type": "string"
    },
    "sourceLabel": {
      "type": "string"
    },
    "sourceStatus": {
      "enum": [
        "verified",
        "unverified",
        "original",
        "unknown"
      ]
    },
    "sourceRef": {
      "type": "string"
    },
    "year": {
      "type": [
        "integer",
        "string"
      ]
    },
    "exam": {
      "type": "string"
    },
    "examTitle": {
      "type": "string"
    },
    "context": {
      "type": "string"
    },
    "figure": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}